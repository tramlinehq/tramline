<%= render SectionComponent.new(style: :titled, title: "Icon", subtitle: "Shown next to the organization name in the header") do %>
  <div class="flex flex-col gap-y-6 w-1/3">
    <% if @organization.icon.attached? %>
      <div class="flex items-center gap-x-2">
        <%= render IconComponent.new(@organization.icon_path, size: :xl_3) %>
        <%= render ButtonComponent.new(
              scheme: :danger,
              label: "Remove icon",
              options: remove_icon_accounts_organization_path(@organization),
              type: :link,
              html_options: {method: :delete, data: {turbo_method: :delete, turbo_confirm: "Are you sure you want to remove this icon?"}}
            ) do |b|
              b.with_icon("trash.svg", size: :sm)
            end %>
      </div>
    <% end %>

    <%= render FormComponent.new(model: @organization, url: accounts_organization_path(@organization), method: :patch, free_form: true) do |f| %>
      <%= f.F.labeled_file_field :icon,
            "Choose icon",
            "512x512 or 1024x1024, square only. Under 1 MiB.",
            accept: "image/png,image/jpeg,image/jpg,image/webp",
            required: true %>

      <% f.with_action do %>
        <%= f.F.authz_submit "Update", "archive.svg" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @organization.sso? %>
  <%= render SectionComponent.new(style: :titled, title: "Authentication", subtitle: "Single Sign-On / SAML configuration") do %>
    <div class="flex flex-col gap-y-6 w-1/3">
      <div class="flex items-center gap-1">
        <%= render BadgeComponent.new(text: "SSO Enabled", status: :success) %>
        <% @organization.sso_domains.each do |domain| %>
          <%= render BadgeComponent.new(text: domain, kind: :badge) %>
        <% end %>
      </div>

      <%= render SmartTextBoxComponent.new(@organization.sso_tenant_id,
                                           label: "SSO Tenant ID",
                                           clipboard: true,
                                           clipboard_tooltip: "Copy ID") %>

      <%= render SmartTextBoxComponent.new(@organization.sso_configuration_link,
                                           label: "SSO Setup Link",
                                           clipboard: true,
                                           clipboard_tooltip: "Copy link") %>
    </div>
  <% end %>
<% end %>

<%= render SectionComponent.new(style: :titled, title: "API", subtitle: "Use these credentials to make API calls to Tramline") do %>
  <div class="flex flex-col gap-y-6 w-1/3">
    <%= render SmartTextBoxComponent.new(@organization.id,
                                         label: "Account ID",
                                         clipboard: true,
                                         clipboard_tooltip: "Copy ID") %>

    <%= render SmartTextBoxComponent.new(@organization.api_key,
                                         label: "API Key",
                                         clipboard: true,
                                         password: true,
                                         clipboard_tooltip: "Copy key") %>
  </div>
<% end %>

<% if @organization.custom_storage.present? %>
  <%= render SectionComponent.new(style: :titled, title: "Custom Storage", subtitle: "Custom storage bucket for build artifacts") do %>
    <div class="flex flex-col gap-y-6 w-1/3">
      <% custom_storage = @organization.custom_storage %>

      <div class="flex items-center gap-1">
        <%= render BadgeComponent.new(text: custom_storage.service_name, status: :success) %>
      </div>

      <%= render SmartTextBoxComponent.new(custom_storage.bucket, label: "Bucket Name", clipboard: false) %>
      <%= render SmartTextBoxComponent.new(custom_storage.bucket_region, label: "Bucket Region", clipboard: false) %>
    </div>
  <% end %>
<% end %>
