# Committed, reference-only secrets manifest — NO literal secret values here.
#
# Kamal loads this first, then .kamal/secrets.<destination> (gitignored) if it
# exists, with the destination file overriding these. So:
#   - Local:  .kamal/secrets.staging (real literal values) wins.
#   - CI:     that file is absent, so these $VARS resolve from the environment
#             (GitHub Actions secrets set in the workflow's env: block).
#
# Every key any destination's deploy config references via `secret:` (or reads
# via `secret:`) must be listed here.

KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

RAILS_MASTER_KEY=$RAILS_MASTER_KEY

POSTGRES_USER=$POSTGRES_USER
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
POSTGRES_DB=$POSTGRES_DB

DATABASE_URL=$DATABASE_URL
REDIS_URL=$REDIS_URL
DEFAULT_REDIS_URL=$DEFAULT_REDIS_URL
SESSION_REDIS_URL=$SESSION_REDIS_URL
SIDEKIQ_REDIS_URL=$SIDEKIQ_REDIS_URL

HOST_NAME=$HOST_NAME

DESCOPE_PROJECT_ID=$DESCOPE_PROJECT_ID
DESCOPE_MANAGEMENT_KEY=$DESCOPE_MANAGEMENT_KEY

APPLELINK_URL=$APPLELINK_URL
AUTH_ISSUER=$AUTH_ISSUER
AUTH_SECRET=$AUTH_SECRET
AUTH_AUD=$AUTH_AUD

SENTRY_DSN=$SENTRY_DSN
FRONTEND_SENTRY_DSN=$FRONTEND_SENTRY_DSN
SENTRY_SECURITY_HEADER_ENDPOINT=$SENTRY_SECURITY_HEADER_ENDPOINT

ARTIFACT_BUILDS_BUCKET_NAME=$ARTIFACT_BUILDS_BUCKET_NAME
APP_REDIRECT_MAPPING_JSON=$APP_REDIRECT_MAPPING_JSON
X_MONITOR_ALLOWED=$X_MONITOR_ALLOWED
DISALLOWED_SIGN_UP_DOMAINS=$DISALLOWED_SIGN_UP_DOMAINS
CSP_CONNECT_SRC_URIS=$CSP_CONNECT_SRC_URIS
